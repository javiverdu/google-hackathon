# Copy to .env and fill in your key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.1-flash-lite
ERASMUS_SEMESTER=2026-27
CONFIDENCE_THRESHOLD=0.7
# Optional: absolute path to data folder (defaults to ./data)
# ERASMUS_DATA_DIR=
